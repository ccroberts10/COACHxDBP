# =====================================================
# DBP Coach — Environment Variables
# =====================================================

# ----- Server -----
PORT=3000
NODE_ENV=production
TZ=America/Denver
PUBLIC_URL=https://coach.durangobikeproject.com

# ----- Database (Postgres on Railway) -----
DATABASE_URL=

# ----- Anthropic (one shared key, billed to DBP) -----
ANTHROPIC_API_KEY=

# ----- WHOOP (one DBP-registered app, OAuth approves users) -----
# Create at https://developer-dashboard.whoop.com/apps/create
# Redirect URI: https://coach.durangobikeproject.com/integrations/whoop/callback
# Privacy URL: https://coach.durangobikeproject.com/privacy
# Required scopes: read:recovery, read:sleep, read:cycles, read:workout, read:profile, read:body_measurement
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# ----- Strava (one DBP-registered app) -----
# Create at https://www.strava.com/settings/api
# Authorization Callback Domain: coach.durangobikeproject.com
# IMPORTANT: Request rate limit increase to ~100k/day after launch (free upgrade)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ----- Email (Resend.com — transactional email) -----
# Sign up at https://resend.com (free tier: 3,000/month)
# Verify domain durangobikeproject.com via DNS
RESEND_API_KEY=
FROM_EMAIL=DBP Coach <coach@durangobikeproject.com>
REPLY_TO=ccroberts10@gmail.com

# ----- Stripe -----
# Live mode keys for production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard → Products
# Create 4 products with these prices:
#   Coach Monthly: $19/mo
#   Coach Annual:  $180/yr
#   Elite Monthly: $39/mo
#   Elite Annual:  $349/yr
STRIPE_PRICE_COACH_MONTHLY=price_
STRIPE_PRICE_COACH_ANNUAL=price_
STRIPE_PRICE_ELITE_MONTHLY=price_
STRIPE_PRICE_ELITE_ANNUAL=price_

# Trial configuration
TRIAL_DAYS=7

# ----- OpenWeather (optional) -----
OPENWEATHER_KEY=

# ----- DBP Brand Configuration -----
DBP_LOCATION_LAT=37.2753
DBP_LOCATION_LNG=-107.8801
DBP_LOCATION_NAME=Durango, CO
DBP_ADDRESS=225 E 8th Ave, Durango, CO
